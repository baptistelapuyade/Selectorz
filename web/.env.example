# Kopieren nach .env.local und ausfüllen. .env.local nie committen.
# Supabase: Project Settings > API Keys (Publishable key) und Project URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Nur serverseitig, kommt später (Mails über Resend)
RESEND_API_KEY=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostHog (public browser configuration)
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_your_project_token
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
